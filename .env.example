# =========================================================================
# Karaoke Forever Pro — environment configuration
# Copy this file to .env and edit. Values shown here are the defaults the
# code falls back to when an env var is unset.
# =========================================================================

# --- API server (Go) ---
ADDR=:8080
DATABASE_PATH=./karaoke.db
STATIC_DIR=./frontend/dist
MEDIA_DIR=./media
BASE_URL=http://localhost:8080
PER_SINGER_LIMIT=2
AUTO_ACCEPT=true
# Comma-separated. Empty = same-origin only. "*" = any origin (no credentials).
ALLOWED_ORIGINS=http://localhost:5173

# --- Worker (Python pipeline service) ---
WORKER_URL=http://localhost:8090
WORKER_TOKEN=change-me-shared-secret
WORKER_ADDR=0.0.0.0
WORKER_PORT=8090
WORKER_CONCURRENCY=1               # 1 GPU = 1 job at a time
WORKER_DEVICE=auto                 # cuda | cpu | auto
WORKER_COMPUTE_TYPE=float16        # float16 | int8_float16 | int8

# --- AI models ---
DEMUCS_MODEL=htdemucs_ft
WHISPER_MODEL=large-v3
# Leave blank to auto-detect:
WHISPER_LANGUAGE=

# --- yt-dlp ---
YT_DLP_FORMAT=bestaudio/best
# Bandwidth cap; blank = unlimited. Examples: 2M, 500K
YT_DLP_RATE_LIMIT=
# Path to a cookies.txt if you need age-gated / region-restricted videos
YT_DLP_COOKIES_FILE=

# --- Importer credentials (optional; Spotify only) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Deploy to VPS (consumed by scripts/deploy-to-vps.sh) ---
VPS_HOST=
VPS_USER=root
VPS_PATH=/srv/karaoke
VPS_SSH_KEY=~/.ssh/id_ed25519
VPS_RSYNC_OPTS=-az --partial --human-readable

# --- Notifications (consumed by worker batch hooks) ---
NOTIFY_EMAIL=
NOTIFY_SLACK_WEBHOOK=
